<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  pom.xml  —  This file is COMPLETE. You do not fill anything in here.
  ============================================================
  WHAT IT IS:
    Maven's build file for inventory-service ONLY. It is a sibling of
    product-service's pom, not a child of some shared parent.

  WHY NO SHARED PARENT/AGGREGATOR POM:
    Each microservice must be buildable, versioned and deployable on its own.
    A shared aggregator quietly couples them: bump one dependency and every
    service rebuilds. The cost is some duplication between poms. That
    duplication is the price of independence — be ready to defend the trade.

  WHAT IS NEW VS product-service:
    Nothing. Same dependencies. @Version (optimistic locking) is plain JPA and
    ships inside spring-boot-starter-data-jpa.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent still gives us managed dependency versions.
         This is NOT an aggregator: it is a published BOM, not one of our modules. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.learn</groupId>
    <artifactId>inventory-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>inventory-service</name>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Embedded Tomcat + @RestController + JSON conversion. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA/Hibernate. Also provides @Version and the optimistic-locking
             machinery this service is built around. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation: @NotNull, @Min, @Positive on your DTOs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Flyway: versioned SQL migrations. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
